{
    "name": "thesis/nats",
    "description": "Async (fiber based) client for Nats.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Valentin Udaltsov",
            "email": "udaltsov.valentin@gmail.com"
        },
        {
            "name": "kafkiansky",
            "email": "vadimzanfir@gmail.com"
        },
        {
            "name": "Thesis Team",
            "homepage": "https://github.com/orgs/thesisphp/people"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-filter": "*",
        "amphp/amp": "^3.1",
        "amphp/byte-stream": "^2.1",
        "amphp/parser": "^1.1",
        "amphp/pipeline": "^1.2",
        "amphp/socket": "^2.3.1",
        "cuyz/valinor": "^1.15 || ^2.3",
        "revolt/event-loop": "^1.0.7",
        "thesis/package-version": "^0.1.2",
        "thesis/time-span": "^0.2.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "symfony/var-dumper": "^6.4.15 || ^7.3.5"
    },
    "conflict": {
        "amphp/dns": "<2.1.2"
    },
    "suggest": {
        "ext-sodium": "Provides Ed25519 for nkey authentication"
    },
    "autoload": {
        "psr-4": {
            "Thesis\\Nats\\": "src/"
        },
        "files": [
            "src/Internal/Id/generateInboxId.php",
            "src/Internal/Id/generateUniqueId.php",
            "src/Internal/Protocol/encodeHeaders.php",
            "src/Internal/Protocol/decodeHeaders.php",
            "src/Internal/Iter/push.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Thesis\\Nats\\": "tests/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
